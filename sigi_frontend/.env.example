# AUSENTRACK Frontend - Plantilla de variables de entorno
# Copia este archivo como ".env" (sin el .example) y ajusta el valor.
# El archivo ".env" NO se sube a Git.

# URL de la API del backend.
# Desarrollo local (por defecto si no defines nada):
REACT_APP_API_URL=http://localhost:8000/api

# Al desplegar en un servidor real seria algo como:
# REACT_APP_API_URL=https://ausentrack.tuempresa.com/api
