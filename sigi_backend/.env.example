# AUSENTRACK - Plantilla de variables de entorno
# Copia este archivo como ".env" (sin el .example) y pon tus valores reales.
# El archivo ".env" NUNCA se sube a Git.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=sigi_db
DB_USER=root
DB_PASSWORD=tu_contrasena_de_mysql
DB_HOST=localhost
DB_PORT=3306

# Token secreto para el webhook publico de JotForm (vacaciones/permisos)
JOTFORM_WEBHOOK_TOKEN=genera-un-token-largo-y-aleatorio

# Dominios autorizados a consumir la API (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limites de peticiones (proteccion contra abuso)
THROTTLE_LOGIN=10/min
THROTTLE_PUBLICO=30/hour

# Solo aplica cuando DEBUG=False. Ponlo en False si tu proxy ya
# se encarga de redirigir a HTTPS.
SECURE_SSL_REDIRECT=True
